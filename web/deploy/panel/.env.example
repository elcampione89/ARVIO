# Web address of the web app (its DNS A record must point at this VPS).
WEB_DOMAIN=myweb.thevaders.tech

# Your panel's app API. Same address the TV app uses (Panel > Settings > App connection).
PANEL_API_URL=https://blacksheep.lol/varvio/arvio-panel/api/arvio/

# Panel > Settings > Web app > Make web app key. Lets the panel see each viewer's real IP.
PANEL_WEB_KEY=

# Your TMDB v3 API key (the same one as in Panel > API keys). Needed for films and series.
TMDB_API_KEY=

# Live TV relay: plain-HTTP TV streams are passed through this server so browsers can play
# them on the secure site. Uses the VPS's bandwidth while someone watches live TV.
# Set to false to turn it off.
PANEL_MEDIA_PROXY=true

# Optional: Trakt (register your own app at trakt.tv/oauth/applications).
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
