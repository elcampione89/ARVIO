{
  "id": "/",
  "name": "ARVIO",
  "short_name": "ARVIO",
  "description": "ARVIO media hub",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    { "src": "/arvio-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/arvio-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/arvio-icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/arvio-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/apple-touch-icon-v3.png", "sizes": "180x180", "type": "image/png", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Search", "short_name": "Search", "url": "/?view=search", "icons": [{ "src": "/arvio-icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Live TV", "short_name": "Live TV", "url": "/?view=tv", "icons": [{ "src": "/arvio-icon-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Library", "short_name": "Library", "url": "/?view=watchlist", "icons": [{ "src": "/arvio-icon-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "screenshots": [
    { "src": "/premium/home.png", "sizes": "1920x1080", "type": "image/jpeg", "form_factor": "wide", "label": "Home" },
    { "src": "/premium/library.png", "sizes": "1920x1080", "type": "image/jpeg", "form_factor": "wide", "label": "Library" },
    { "src": "/premium/tv.png", "sizes": "1920x1080", "type": "image/jpeg", "form_factor": "wide", "label": "Live TV" }
  ]
}
