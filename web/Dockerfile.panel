# ARVIO web app in panel mode: accounts, profile sync, addons, collections and live TV come
# from your ARVIO panel. Built by .github/workflows/web-panel.yml; see deploy/panel/README.md.
FROM node:22.23.3-bookworm-slim@sha256:25330af3531fb5e23318554a0aa911125b6e91b1b777edf7655501d207c067a2 AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
ENV NEXT_PUBLIC_PANEL_MODE=true \
    NEXT_PUBLIC_SELF_HOSTED=false \
    NEXT_PUBLIC_PAYWALL_ENABLED=false \
    NEXT_PUBLIC_TELEGRAM_ENABLED=false \
    ARVIO_TRANSLATION_MODE=prebuilt \
    ARVIO_STANDALONE=true
# Purple brand (matches the Arvio v2 TV app): swap the stock green accent.
RUN sed -i -e 's/#00d588/#9b5cff/gI' -e 's/rgba(0, 213, 136,/rgba(155, 92, 255,/g' -e 's/#09b3f0/#d16cff/gI' app/*.css \
 && sed -i -e 's/#0bfab6/#b07cff/gI' public/arvio-wordmark.svg \
 && cp deploy-assets/panel-brand/* public/ \
 && npm run build

FROM node:22.23.3-bookworm-slim@sha256:25330af3531fb5e23318554a0aa911125b6e91b1b777edf7655501d207c067a2 AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_PANEL_MODE=true \
    HOSTNAME=0.0.0.0 \
    PORT=3000
COPY --from=build --chown=node:node /app/.next/standalone ./
COPY --from=build --chown=node:node /app/.next/static ./.next/static
COPY --from=build --chown=node:node /app/public ./public
RUN mkdir -p /app/.data/simkl-sessions && chown -R node:node /app/.data && chmod 700 /app/.data
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s \
  CMD node -e "fetch('http://127.0.0.1:3000/version.json',{signal:AbortSignal.timeout(4000)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
